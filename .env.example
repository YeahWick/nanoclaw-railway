# --- Auth (pick one) ---
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=...

# --- Assistant identity ---
ASSISTANT_NAME=Andy

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_ONLY=true          # Set to disable WhatsApp (auto-detected if TELEGRAM_BOT_TOKEN is set)

# --- Process mode (Railway / no Docker-in-Docker) ---
# PROCESS_MODE=true            # Run agent-runner as child process instead of container

# --- Data directories (override for Railway volume mount) ---
# NANOCLAW_STORE_DIR=/data/store
# NANOCLAW_GROUPS_DIR=/data/groups
# NANOCLAW_DATA_DIR=/data/data

# --- Container settings (container mode only) ---
# CONTAINER_IMAGE=nanoclaw-agent:latest
# CONTAINER_TIMEOUT=1800000
# IDLE_TIMEOUT=1800000
# MAX_CONCURRENT_CONTAINERS=5
